{
  "name": "homepage",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "build": "vite build && pagefind --site .svelte-kit/cloudflare",
    "cf:deploy": "pnpm run build && wrangler deploy",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "dev": "vite dev",
    "format": "ultracite fix",
    "lint": "ultracite check",
    "prepare": "svelte-kit sync || echo ''",
    "preview": "pnpm run build && wrangler dev",
    "preview:test": "pnpm run build && wrangler dev --port 8787",
    "test": "playwright install --with-deps chromium && playwright test",
    "test:ci": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@kitlangton/rolling-number": "^0.4.1",
    "arktype": "^2.2.8",
    "bits-ui": "^2.19.5",
    "clsx": "^2.1.1",
    "shadcn-svelte": "^1.7.0",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.15",
    "@iconify-json/lucide": "^1.2.142",
    "@internationalized/date": "^3.12.4",
    "@playwright/test": "^1.64.0",
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "github-slugger": "^2.0.0",
    "mdsvex": "^0.12.8",
    "pagefind": "^1.5.2",
    "shiki": "^4.5.0",
    "sitemapper": "^4.1.6",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "ultracite": "8.0.0",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0"
  },
  "packageManager": "pnpm@11.18.0"
}
